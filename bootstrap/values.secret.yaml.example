# Copy this file to values.secret.yaml and fill in your values.
# Do NOT commit values.secret.yaml — it is gitignored.

logging_s3_bucket:
  access_key_id: <your-access-key-id>
  access_key_secret: <your-access-key-secret>
  bucketnames: <your-bucket-name>
  endpoint: https://s3-openshift-storage.apps.ocp4-bm.redhat.arrowlabs.be

maas_external_provider:
  api_key: <your-api-key>
  endpoint: <your-endpoint>

rag:
  llm_api_key: <your-llm-api-key>
  llm_endpoint: <your-llm-endpoint>
# for example qwen38-27b, which supports Dutch as well
  llm_model: <your-llm-model>
# for example: bge-m3 supports Dutch, takes long inputs and can be hosted using CPUs
  embedding_endpoint: https://baai-bge-m3-predictor.ogx.svc.cluster.local:8443/v1
  # Served under the InferenceService name, not the Hugging Face model id
  embedding_model: baai-bge-m3
