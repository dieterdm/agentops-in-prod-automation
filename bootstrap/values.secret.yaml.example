# Copy this file to values.secret.yaml and fill in your values.
# Do NOT commit values.secret.yaml — it is gitignored.

# Credentials for S4, which serves every S3 bucket in this project (LokiStack,
# the auto pipeline server). Pick any access key and secret, S4 creates its S3
# user from them. The UI login is for the S4 web console route.
s4:
  access_key_id: <your-access-key-id>
  access_key_secret: <your-access-key-secret>
  ui_username: admin
  ui_password: <your-ui-password>

maas_external_provider:
  api_key: <your-api-key>
  endpoint: <your-endpoint>

# Only needed when ogx.enabled is true in values.yaml
rag:
  llm_api_key: <your-llm-api-key>
  llm_endpoint: <your-llm-endpoint>
# for example qwen38-27b, which supports Dutch as well
  llm_model: <your-llm-model>
# for example: multilingual-e5-large supports Dutch and can be hosted using CPUs
  embedding_endpoint: https://redhataimultilingual-e5-large-predictor.ogx.svc.cluster.local:8443/v1
  # Served under the InferenceService name, not the Hugging Face model id
  embedding_model: redhataimultilingual-e5-large
